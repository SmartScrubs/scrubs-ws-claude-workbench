#!/usr/bin/env bash
# scry — look into your repomancer workspaces: list them, open one in iTerm2,
# start a new one, or change repomancer's settings.
#
# Usage: scry              interactive menu (uses fzf when installed)
#        scry --list       print the workspaces and exit
#        scry --update     update scry and repomancer now
#
# In the menu:
#   enter    open the workspace in a new iTerm2 tab (resumes its Claude session)
#   ctrl-v   open it in a new iTerm2 pane beside the current one
#   ctrl-h   open it in a new iTerm2 pane below the current one
#   ctrl-n   new workspace (asks whether to start it in a new tab or a pane)
#   ctrl-s   settings
#   esc      quit
#
# Reads the same settings as repomancer: environment variables, then
# ~/.config/repomancer/config, then the defaults. Its own setting:
#   SCRY_CLOSE_ON_EXIT   close the tab/pane when Claude Code exits (default: yes)
#
# The list refreshes by itself while the menu is open (with fzf 0.45 or later),
# and scry restarts itself after updating (see REPOMANCER_AUTO_UPDATE).

# The whole script is one { … } block: bash reads all of it before running
# anything, so editing or updating this file while it runs can't break it.
{
set -euo pipefail

die()  { echo "scry: $*" >&2; exit 1; }
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
tilde() { printf '%s' "${1/#$HOME/~}"; }   # /Users/me/x → ~/x, for display
# fit <width> <text>: shorten to width, marking the cut with "~"
fit() { if (( ${#2} > $1 )); then printf '%s~' "${2:0:$(( $1 - 1 ))}"; else printf '%s' "$2"; fi; }

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/repomancer/config"
DEFAULT_ROOT="$HOME/Documents/AIProjects"
DEFAULT_REPO="https://github.com/SmartScrubs/scrubs.git"
DEFAULT_AGENTS_REPO="https://github.com/SmartScrubs/agents-md.git"

# Same lookup as repomancer: environment, then config file, then default.
ENV_ROOT="${REPOMANCER_ROOT:-}" ENV_REPO="${REPOMANCER_REPO:-}"
ENV_INTENT="${REPOMANCER_INTENT:-}" ENV_AGENTS_REPO="${REPOMANCER_AGENTS_REPO:-}"
ENV_CLOSE="${SCRY_CLOSE_ON_EXIT:-}" ENV_AUTO_UPDATE="${REPOMANCER_AUTO_UPDATE:-}"
# Read one setting from the config file. A subshell keeps the config from
# changing this process's (exported) environment, which repomancer inherits.
cfg_get() {
  (
    unset "$1"
    # shellcheck source=/dev/null
    [[ -f "$CONFIG" ]] && source "$CONFIG" >/dev/null 2>&1
    eval "printf '%s' \"\${$1:-}\""
  )
}
load_settings() {
  CFG_ROOT="$(cfg_get REPOMANCER_ROOT)" CFG_REPO="$(cfg_get REPOMANCER_REPO)"
  CFG_INTENT="$(cfg_get REPOMANCER_INTENT)" CFG_AGENTS_REPO="$(cfg_get REPOMANCER_AGENTS_REPO)"
  CFG_CLOSE="$(cfg_get SCRY_CLOSE_ON_EXIT)" CFG_AUTO_UPDATE="$(cfg_get REPOMANCER_AUTO_UPDATE)"
  CLOSE_ON_EXIT="$(lower "${ENV_CLOSE:-${CFG_CLOSE:-yes}}")"
  ROOT="${ENV_ROOT:-${CFG_ROOT:-$DEFAULT_ROOT}}"
  ROOT="${ROOT/#\~/$HOME}"
}
load_settings

HAVE_FZF=""; command -v fzf >/dev/null 2>&1 && HAVE_FZF=1

# The folder this script really lives in, following symlinks. repomancer is
# next to it, in the same clone of the workbench repo.
self_dir() {
  local p="$0" t
  while [[ -L "$p" ]]; do
    t="$(readlink "$p")"; [[ "$t" == /* ]] || t="$(dirname "$p")/$t"; p="$t"
  done
  (cd "$(dirname "$p")" && pwd -P)
}
SELF="$(self_dir)/scry"
REPOMANCER="$(self_dir)/repomancer"
[[ -x "$REPOMANCER" ]] || REPOMANCER=repomancer
BOLD=$'\033[1m' DIM=$'\033[2m' RED=$'\033[31m' GREEN=$'\033[32m' YELLOW=$'\033[33m' RESET=$'\033[0m'

# --- workspaces ------------------------------------------------------------
# "3m", "5h", "2d", "6w"
ago() {
  local s=$(( $(date +%s) - $1 ))
  if   (( $1 == 0 ));    then echo "-"   # nothing yet, e.g. still cloning
  elif (( s < 3600 ));   then echo "$(( s / 60 ))m"
  elif (( s < 86400 ));  then echo "$(( s / 3600 ))h"
  elif (( s < 1209600 )); then echo "$(( s / 86400 ))d"
  else echo "$(( s / 604800 ))w"
  fi
}

# Last activity: the newest Claude transcript for the folder, or else the last commit.
last_activity() {
  local dir="$1" pd newest t
  pd="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$(cd "$dir" && pwd -P | sed 's/[^A-Za-z0-9]/-/g')"
  newest="$(ls -t "$pd"/*.jsonl 2>/dev/null | head -1 || true)"
  if [[ -n "$newest" ]]; then
    stat -f %m "$newest"
  else
    t="$(git -C "$dir" log -1 --format=%ct 2>/dev/null || true)"
    echo "${t:-0}"
  fi
}

# One tab-separated line per workspace, newest first:
#   epoch  name  branch  intent  changed-files  unpushed-commits
collect() {
  local d name
  [[ -d "$ROOT" ]] || return 0
  for d in "$ROOT"/*/; do
    d="${d%/}"
    [[ -e "$d/.git" ]] || continue
    name="$(basename "$d")"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$(last_activity "$d")" "$name" \
      "$(git -C "$d" branch --show-current 2>/dev/null || echo '?')" \
      "$(git -C "$d" config repomancer.intent 2>/dev/null || echo '-')" \
      "$(git -C "$d" status --porcelain 2>/dev/null | wc -l | tr -d ' ')" \
      "$(git -C "$d" rev-list --count HEAD --not --remotes=origin 2>/dev/null || echo 0)"
  done | sort -t$'\t' -k1,1nr
}

# Lines for the menu: "<key>\t<display>". The key is the folder name.
# "3 changed, 2 unpushed" / "clean"
state_text() {  # <changed> <unpushed>
  local t=""
  (( $1 > 0 )) && t="$1 changed"
  (( $2 > 0 )) && t="${t:+$t, }$2 unpushed"
  echo "${t:-clean}"
}

# Lines for the menu: "<key>\t<display>". The key is the folder name. Status
# comes early so it stays visible beside the preview; the branch is only shown
# when it differs from the folder name.
menu_lines() {
  local epoch name branch intent changed unpushed color extra
  while IFS=$'\t' read -r epoch name branch intent changed unpushed; do
    if   (( unpushed > 0 )); then color="$RED"
    elif (( changed > 0 ));  then color="$YELLOW"
    else color="$GREEN"; fi
    extra=""; [[ "$branch" == "$name" ]] || extra="  ${DIM}⎇ $branch${RESET}"
    printf '%s\t%-28s %4s  %s%-22s%s %-8s%s\n' "$name" "$(fit 28 "$name")" "$(ago "$epoch")" \
      "$color" "$(state_text "$changed" "$unpushed")" "$RESET" "$(fit 8 "$intent")" "$extra"
  done < <(collect)
}

list_plain() {
  local epoch name branch intent changed unpushed
  printf '%-28s %4s  %-22s %-8s %s\n' WORKSPACE AGE STATUS INTENT BRANCH
  while IFS=$'\t' read -r epoch name branch intent changed unpushed; do
    printf '%-28s %4s  %-22s %-8s %s\n' "$(fit 28 "$name")" "$(ago "$epoch")" \
      "$(state_text "$changed" "$unpushed")" "$(fit 8 "$intent")" "$branch"
  done < <(collect)
}

preview() {
  local d="$ROOT/$1"
  [[ -d "$d" ]] || { echo "$1"; return 0; }
  echo "${BOLD}$1${RESET}  ${DIM}$(tilde "$d")${RESET}"
  local agents="none"
  [[ -f "$d/AGENTS.md" ]] && agents="$(head -1 "$d/AGENTS.md" | sed 's/^# *//; s/^AGENTS\.md: *//')"
  echo "intent: $(git -C "$d" config repomancer.intent 2>/dev/null || echo -)   AGENTS.md: $agents"
  echo
  git -C "$d" -c color.status=always status -sb 2>/dev/null | head -25
  echo
  git -C "$d" log --color=always --format='%C(yellow)%h%C(reset) %s %C(dim)(%cr)%C(reset)' -10 2>/dev/null
}

# What makes a row change: workspaces appearing or going away, and their
# branch or intent (HEAD and config change while a new one is set up). Not the
# .git folder's own time: git status, which the list itself runs, changes that.
signature() {
  [[ -d "$ROOT" ]] || return 0
  ls -d "$ROOT"/*/.git 2>/dev/null || true
  stat -f '%N %m' "$ROOT"/*/.git/HEAD "$ROOT"/*/.git/config 2>/dev/null || true
}

# Runs in the background while the fzf menu is open, started by fzf itself
# (so FZF_PORT is set). It reloads the list when signature() changes, for
# instance once a workspace started from the menu has been cloned, and exits
# when that fzf has.
watch_list() {
  local last="${SCRY_SIGNATURE:-}" now api="localhost:${FZF_PORT:?}"
  while sleep 2; do
    curl -fs -m 2 -H "x-api-key: $FZF_API_KEY" "$api?limit=0" >/dev/null 2>&1 || return 0
    now="$(signature)"
    [[ "$now" != "$last" ]] || continue
    last="$now"
    # reload-sync keeps the old rows on screen until the new ones are ready.
    curl -fs -m 2 -X POST -H "x-api-key: $FZF_API_KEY" "$api" \
      -d "reload-sync($(printf %q "$SELF") --entries)" >/dev/null 2>&1 || return 0
  done
}

# fzf 0.45 or later has everything watch_list needs (--listen, FZF_PORT, start).
fzf_can_listen() {
  local v major minor
  v="$(fzf --version 2>/dev/null)"; v="${v%% *}"
  major="${v%%.*}" minor="${v#*.}"; minor="${minor%%.*}"
  [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] || return 1
  (( major > 0 || minor >= 45 ))
}

# --- updates ---------------------------------------------------------------
# Ask repomancer to update the clone both scripts live in (at most once an
# hour, unless turned off), and restart scry if it did.
check_updates() {
  local msg
  msg="$("$REPOMANCER" --update-if-due 2>/dev/null)" || return 0
  [[ -n "$msg" ]] || return 0
  SCRY_STATUS="$msg" exec "$SELF"
}

# --- iTerm2 ----------------------------------------------------------------
# iterm_run <tab|vsplit|hsplit> <command>: run a command in a new iTerm2 tab of
# the current window, or in a new pane beside (vsplit) or below (hsplit) the
# current session (the one
# scry runs in, when it runs in iTerm2). With no window open, both open one.
iterm_run() {
  local mode="$1" cmd="$2"
  [[ -d /Applications/iTerm.app || -d "$HOME/Applications/iTerm.app" ]] || die "iTerm2 isn't installed"
  osascript - "$mode" "$cmd" >/dev/null <<'APPLESCRIPT'
on run argv
  set mode to item 1 of argv
  set cmd to item 2 of argv
  tell application "iTerm"
    activate
    if (count of windows) is 0 then
      set s to current session of (create window with default profile)
    else if mode is "vsplit" then
      tell current session of current window
        set s to (split vertically with default profile)
      end tell
    else if mode is "hsplit" then
      tell current session of current window
        set s to (split horizontally with default profile)
      end tell
    else
      tell current window
        set t to (create tab with default profile)
      end tell
      set s to current session of t
    end if
    tell s to write text cmd
  end tell
end run
APPLESCRIPT
}

# Build a repomancer command line. The new tab starts a fresh shell, so pass on
# settings that only exist in this environment.
repomancer_cmd() {
  local cmd="" arg
  [[ -n "$ENV_ROOT" ]] && cmd+="REPOMANCER_ROOT=$(printf %q "$ENV_ROOT") "
  [[ -n "$ENV_REPO" ]] && cmd+="REPOMANCER_REPO=$(printf %q "$ENV_REPO") "
  [[ -n "$ENV_AGENTS_REPO" ]] && cmd+="REPOMANCER_AGENTS_REPO=$(printf %q "$ENV_AGENTS_REPO") "
  cmd+="repomancer"
  for arg in "$@"; do cmd+=" $(printf %q "$arg")"; done
  echo "$cmd"
}

# The command typed into a new tab or pane. With SCRY_CLOSE_ON_EXIT (default
# yes), the shell exits after Claude Code does, so iTerm2 closes the tab or
# pane. "&&" keeps it open when repomancer fails, so its error stays readable.
session_cmd() {
  case "$CLOSE_ON_EXIT" in
    no|false|0|off) echo "$1" ;;
    *)              echo "$1 && exit" ;;
  esac
}

where() {  # <tab|vsplit|hsplit> → words for messages
  case "$1" in vsplit) echo "pane beside this one" ;; hsplit) echo "pane below this one" ;; *) echo "tab" ;; esac
}

open_workspace() {  # <tab|vsplit|hsplit> <name>
  iterm_run "$1" "$(session_cmd "$(repomancer_cmd "$2")")"
  STATUS="Opened $2 in a new iTerm2 $(where "$1")."
  echo "$STATUS"
}

# --- prompts ---------------------------------------------------------------
# input "Prompt" [default] [hint] → prints the text typed. Fails (status 1)
# when cancelled: Esc with fzf (a one-line fzf with no list is a text box;
# Enter exits 1 with the text, Esc/ctrl-c exit 130), or "q" without it.
input() {
  local prompt="$1" default="${2:-}" hint="${3:-}" out rc=0 reply
  if [[ -n "$HAVE_FZF" ]]; then
    out="$(fzf --print-query --height=4 --reverse --no-info --prompt="$prompt: " --query="$default" \
               --header="${hint:+$hint · }enter: continue · esc: cancel" </dev/null)" || rc=$?
    (( rc != 130 )) || return 1
    head -1 <<<"$out"
  else
    read -r -p "$prompt${default:+ [$default]}${hint:+ ($hint)}, q to cancel: " reply || return 1
    [[ "$reply" != q ]] || return 1
    echo "${reply:-$default}"
  fi
}

# pick "Prompt" option... → prints the chosen option (empty if cancelled with
# Esc, or with Enter / "q" in the numbered fallback)
pick() {
  local prompt="$1"; shift
  if [[ -n "$HAVE_FZF" ]]; then
    printf '%s\n' "$@" | fzf --height=~15 --reverse --prompt="$prompt > " --header="enter: choose · esc: cancel" || true
  else
    local i=1 o n
    for o in "$@"; do echo "  $i) $o" >&2; i=$((i + 1)); done
    while true; do
      read -r -p "$prompt (number; Enter or q to cancel): " n || return 0
      [[ -n "$n" && "$n" != q ]] || return 0
      if [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= $# )); then
        eval "echo \"\${$n}\""; return 0
      fi
      echo "  Please enter a number from 1 to $#." >&2
    done
  fi
}

intents() {
  repomancer --list-intents 2>/dev/null | sed -n 's/^  //p'
}

cancelled() { STATUS="Cancelled."; return 0; }

# place_options <tab|vsplit|hsplit> <verb>: one "Yes, <verb> in a new …" line
# for each place a workspace can open, the given one first, then "No, cancel".
place_options() {
  local m
  echo "Yes, $2 in a new $(where "$1")"
  for m in tab vsplit hsplit; do
    [[ "$m" == "$1" ]] || echo "Yes, $2 in a new $(where "$m")"
  done
  echo "No, cancel"
}

choice_mode() {  # an answer from place_options → tab|vsplit|hsplit
  case "$1" in *beside*) echo vsplit ;; *below*) echo hsplit ;; *) echo tab ;; esac
}

new_workspace() {  # [tab|vsplit|hsplit]
  local mode="${1:-tab}" branch base intent default_intent options=() places=() i dir choice
  clear_screen; echo "${BOLD}New workspace${RESET}"
  [[ -n "$HAVE_FZF" ]] || echo "${DIM}Type q at any prompt to cancel.${RESET}"

  while true; do
    branch="$(input "Branch name")" || { cancelled; return 0; }
    [[ -n "$branch" ]] || { cancelled; return 0; }
    git check-ref-format --branch "$branch" >/dev/null 2>&1 && break
    echo "${RED}'$branch' isn't a valid branch name; try another.${RESET}"
  done

  dir="${branch//\//-}"
  if [[ -e "$ROOT/$dir" ]]; then
    while IFS= read -r i; do places+=("$i"); done < <(place_options "$mode" "reopen it")
    choice="$(pick "$dir already exists. Reopen it?" "${places[@]}")"
    if [[ "$choice" == Yes* ]]; then open_workspace "$(choice_mode "$choice")" "$dir"; else cancelled; fi
    return 0
  fi

  base="$(input "Base branch" "" "empty: the repo's default branch")" || { cancelled; return 0; }

  default_intent="$(lower "${ENV_INTENT:-${CFG_INTENT:-default}}")"
  options=("$default_intent")
  while IFS= read -r i; do [[ "$i" == "$default_intent" ]] || options+=("$i"); done < <(intents)
  intent="$(pick "Intent" "${options[@]}")"
  [[ -n "$intent" ]] || { cancelled; return 0; }

  while IFS= read -r i; do places+=("$i"); done < <(place_options "$mode" "start it")
  choice="$(pick "Start $branch${base:+ from $base} with intent '$intent'?" "${places[@]}")"
  [[ "$choice" == Yes* ]] || { cancelled; return 0; }
  mode="$(choice_mode "$choice")"

  iterm_run "$mode" "$(session_cmd "$(repomancer_cmd "$branch" ${base:+"$base"} --intent "$intent")")"
  STATUS="Started $branch ($intent) in a new iTerm2 $(where "$mode")."
  echo "$STATUS"
}

# --- settings --------------------------------------------------------------
# set_config KEY [VALUE]: write KEY="VALUE" to the config file, replacing the
# first KEY= line (commented out or not). No VALUE comments the setting out,
# which restores the default.
set_config() {
  local key="$1" value="${2:-}" line done="" tmp escaped
  mkdir -p "$(dirname "$CONFIG")"; touch "$CONFIG"
  escaped="$(printf '%s' "$value" | sed 's/[\"$`]/\\&/g')"
  tmp="$(mktemp)"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -z "$done" && "$line" =~ ^#?[[:space:]]*$key= ]]; then
      if [[ -n "$value" ]]; then echo "$key=\"$escaped\""; else echo "#$key=\"\""; fi
      done=1
    else
      printf '%s\n' "$line"
    fi
  done < "$CONFIG" > "$tmp"
  if [[ -z "$done" && -n "$value" ]]; then echo "$key=\"$escaped\"" >> "$tmp"; fi
  cat "$tmp" > "$CONFIG" && rm -f "$tmp"
  load_settings
}

# "value  (from …)" for the settings menu
describe() {  # <env value> <config value> <default>
  if   [[ -n "$1" ]]; then echo "$1  (environment variable; overrides the config file)"
  elif [[ -n "$2" ]]; then echo "$2"
  else echo "$3  (default)"
  fi
}

settings() {
  local choice value
  clear_screen
  while true; do
    load_settings
    echo
    choice="$(pick "Settings" \
      "Workspace folder:  $(describe "$ENV_ROOT" "$CFG_ROOT" "$DEFAULT_ROOT")" \
      "Default intent:    $(describe "$ENV_INTENT" "$CFG_INTENT" default)" \
      "Repo to clone:     $(describe "$ENV_REPO" "$CFG_REPO" "$DEFAULT_REPO")" \
      "Agents repo:       $(describe "$ENV_AGENTS_REPO" "$CFG_AGENTS_REPO" "$DEFAULT_AGENTS_REPO")" \
      "Close tab/pane when Claude exits: $(describe "$ENV_CLOSE" "$CFG_CLOSE" yes)" \
      "Update automatically:             $(describe "$ENV_AUTO_UPDATE" "$CFG_AUTO_UPDATE" yes)" \
      "Check for updates now" \
      "Edit the config file" \
      "Back")"
    case "$choice" in
      "Workspace folder"*)
        value="$(input "Workspace folder" "${CFG_ROOT:-}" "empty: the default")" || continue
        value="${value/#\~/$HOME}"
        if [[ -n "$value" && ! -d "$value" ]]; then
          [[ "$(pick "$value doesn't exist. Create it?" "Yes, create it" "No, cancel")" == Yes* ]] || continue
          mkdir -p "$value"
        fi
        set_config REPOMANCER_ROOT "$value" ;;
      "Default intent"*)
        value="$(pick "Default intent" "(none: use 'default')" $(intents | grep -vx default))"
        [[ -n "$value" ]] || continue
        [[ "$value" == "(none"* ]] && value=""
        set_config REPOMANCER_INTENT "$value" ;;
      "Repo to clone"*|"Agents repo"*)
        local key=REPOMANCER_REPO current="$CFG_REPO"
        [[ "$choice" == "Agents repo"* ]] && key=REPOMANCER_AGENTS_REPO current="$CFG_AGENTS_REPO"
        value="$(input "Git URL" "$current" "empty: the default")" || continue
        if [[ -n "$value" ]] && ! GIT_TERMINAL_PROMPT=0 git ls-remote "$value" HEAD >/dev/null 2>&1; then
          echo "${RED}Can't reach $value with your git credentials; not saved.${RESET}"; continue
        fi
        set_config "$key" "$value" ;;
      "Close tab/pane"*)
        value="$(pick "Close the tab or pane when Claude Code exits?" yes no)"
        [[ -n "$value" ]] || continue
        set_config SCRY_CLOSE_ON_EXIT "$value" ;;
      "Update automatically"*)
        value="$(pick "Update repomancer and scry automatically?" yes no)"
        [[ -n "$value" ]] || continue
        set_config REPOMANCER_AUTO_UPDATE "$value" ;;
      "Check for updates now")
        value="$("$REPOMANCER" --update 2>&1)" || true
        if [[ "$value" == Updated* ]]; then SCRY_STATUS="$value" exec "$SELF"; fi
        echo "${value#repomancer: }"; continue ;;
      "Edit the config file")
        [[ -f "$CONFIG" ]] || set_config REPOMANCER_ROOT ""
        "${VISUAL:-${EDITOR:-nano}}" "$CONFIG" ;;
      *) return 0 ;;
    esac
    STATUS="Saved to $CONFIG"; echo "${GREEN}$STATUS${RESET}"
  done
}

# --- menus -----------------------------------------------------------------
NEW_KEY="__new__" SETTINGS_KEY="__settings__"
STATUS="${SCRY_STATUS:-}"   # result of the last action, shown at the top of the menu
unset SCRY_STATUS

# Short lines, so the help fits beside the preview pane.
menu_header() {
  echo "enter tab · ^V pane beside · ^H pane below"
  echo "^N new · ^S settings · esc quit"
  echo "${DIM}$(tilde "$ROOT")${RESET}"
  [[ -z "$STATUS" ]] || echo "${GREEN}$STATUS${RESET}"
}

clear_screen() { clear 2>/dev/null || printf '\033[H\033[2J'; }

# The menu's rows: "New workspace" and "Settings", then the workspaces.
entries() {
  printf '%s\t%s\n' "$NEW_KEY" "${GREEN}+ New workspace…${RESET}" \
                    "$SETTINGS_KEY" "${DIM}⚙ Settings…${RESET}"
  menu_lines
}

menu_fzf() {
  local out key selection mode live=()
  if fzf_can_listen; then
    # fzf listens on a random local port; the key keeps other programs out.
    export FZF_API_KEY
    FZF_API_KEY="$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    live=(--listen --bind "start:execute-silent:$(printf %q "$SELF") --watch </dev/null >/dev/null 2>&1 &")
    # Keep the cursor on the same workspace when the list reloads (fzf 0.66+).
    if fzf --track --id-nth=1 --filter=x </dev/null >/dev/null 2>&1 || (( $? == 1 )); then
      live+=(--track --id-nth=1)
    fi
  fi
  while true; do
    check_updates
    export SCRY_SIGNATURE; SCRY_SIGNATURE="$(signature)"
    out="$( entries \
      | fzf --ansi --reverse --delimiter=$'\t' --with-nth=2.. ${live[@]+"${live[@]}"} \
            --prompt="scry > " --expect=ctrl-v,ctrl-h,ctrl-n,ctrl-s \
            --header="$(menu_header)" \
            --preview="[ {1} = $NEW_KEY ] || [ {1} = $SETTINGS_KEY ] || $(printf %q "$0") --preview {1}" \
            --preview-window='right,50%,<70(down,50%)' )" || return 0
    key="$(head -1 <<<"$out")"
    selection="$(sed -n 2p <<<"$out" | cut -f1)"
    # ctrl-n / ctrl-s act wherever the cursor is; otherwise the row decides,
    # and ctrl-v / ctrl-h choose where it opens.
    case "$key" in ctrl-v) mode=vsplit ;; ctrl-h) mode=hsplit ;; *) mode=tab ;; esac
    case "$key" in
      ctrl-n) new_workspace tab ;;
      ctrl-s) settings ;;
      *) case "$selection" in
           "")              ;;
           "$NEW_KEY")      new_workspace "$mode" ;;
           "$SETTINGS_KEY") settings ;;
           *)               open_workspace "$mode" "$selection" ;;
         esac ;;
    esac
  done
}

menu_plain() {
  local names=() line n
  while true; do
    check_updates
    names=()
    clear_screen
    echo "${BOLD}repomancer workspaces${RESET} ${DIM}in $(tilde "$ROOT")${RESET}"
    [[ -z "$STATUS" ]] || echo "${GREEN}$STATUS${RESET}"
    while IFS=$'\t' read -r key line; do
      names+=("$key"); printf '%3d) %s\n' "${#names[@]}" "$line"
    done < <(menu_lines)
    (( ${#names[@]} )) || echo "    (none yet)"
    echo "  n) new workspace   s) settings   q) quit"
    read -r -p "Open which? (number; v<number> pane beside, h<number> pane below): " n || return 0
    case "$n" in
      q|Q|"") return 0 ;;
      n|N) new_workspace tab ;;
      s|S) settings ;;
      [vh][0-9]*)
        local mode=vsplit; [[ "$n" == h* ]] && mode=hsplit
        n="${n#?}"; (( n >= 1 && n <= ${#names[@]} )) && open_workspace "$mode" "${names[$((n - 1))]}" ;;
      [0-9]*) (( n >= 1 && n <= ${#names[@]} )) && open_workspace tab "${names[$((n - 1))]}" ;;
      *) echo "?" ;;
    esac
  done
}

case "${1:-}" in
  --list)    list_plain ;;
  --preview) preview "${2:?}" ;;
  --entries) entries ;;
  --watch)   watch_list ;;
  --update)  "$REPOMANCER" --update ;;
  -h|--help) sed -n '2,22s/^# \{0,1\}//p' "$0" ;;
  "")        if [[ -n "$HAVE_FZF" ]]; then menu_fzf; else menu_plain; fi ;;
  *)         die "unknown option: $1 (see scry --help)" ;;
esac

exit
}
